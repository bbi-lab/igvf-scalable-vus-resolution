################################################################################
# macOS
################################################################################
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

################################################################################
# Python
################################################################################
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Tooling caches
.ruff_cache/
.mypy_cache/
.pytest_cache/

################################################################################
# Jupyter
################################################################################
.ipynb_checkpoints/

################################################################################
# R
################################################################################
.Rhistory
.RData
.Rproj.user/

# R's default graphics device output -- created whenever a plot is drawn
# (e.g. print()) with no device explicitly open; not a real output file.
Rplots.pdf

################################################################################
# nbconvert/rmarkdown::render() execution byproducts
################################################################################
# nbconvert --execute's own copy of a notebook with outputs attached, and
# rmarkdown::render()'s knitted HTML -- both named executed_<name>.<ext> by
# convention (see docs/figures.md) and left next to the source script,
# not worth tracking.
executed_*.ipynb
executed_*.html

################################################################################
# Pipeline scratch
################################################################################
# Staging copy of data/raw_mave_data/, mounted into the variant-annotation
# container as VARIANT_DATA_DIR -- regenerated by
# scripts/run_variant_annotation_pipeline.sh on every run.
data/intermediate/

# Generated/large data directories -- kept as empty folders in git via a
# .gitkeep placeholder so the expected paths exist on a fresh clone, but their
# actual contents (regenerated or hand-supplied locally) aren't tracked.
data/input/mave_calibration/excalibr/*
!data/input/mave_calibration/excalibr/.gitkeep

data/input/biobank/*
!data/input/biobank/.gitkeep

# User-downloaded GRCh38 reference FASTA + gnomAD v4.1 sites VCFs for
# src/map_gnomad_ancestry.py -- hundreds of GB, never committed. The small,
# checked-in data/input/gnomAD/*.csv ancestry-mapped files (consumed by
# src/make_extended_data_figure_10.py) live directly under data/input/gnomAD/
# and are unaffected by these two patterns.
data/input/gnomAD/reference/*
!data/input/gnomAD/reference/.gitkeep

data/input/gnomAD/vcf/*
!data/input/gnomAD/vcf/.gitkeep

data/output/*
!data/output/supplementary_data/
data/output/supplementary_data/*
!data/output/supplementary_data/.gitkeep

!data/output/maves/
data/output/maves/*
!data/output/maves/.gitkeep

!data/output/mave_calibration/
data/output/mave_calibration/*
!data/output/mave_calibration/oddspath/
data/output/mave_calibration/oddspath/*
!data/output/mave_calibration/oddspath/.gitkeep

!data/output/predictor_calibration/
data/output/predictor_calibration/*
!data/output/predictor_calibration/gene_specific/
data/output/predictor_calibration/gene_specific/*
!data/output/predictor_calibration/gene_specific/.gitkeep

!data/output/reclassification/
data/output/reclassification/*
!data/output/reclassification/.gitkeep
