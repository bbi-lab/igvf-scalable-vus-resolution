    family-names: Stone
    orcid: "https://orcid.org/0000-0002-7565-2463"
  - given-names: Malvika
    family-names: Tejura
  - given-names: Ross
    family-names: Stewart
  - given-names: Yuriy
    family-names: Sverchkov
  - given-names: Ivan
    family-names: Woo
  - given-names: Haneen
    family-names: Abderrazzaq
repository-code: "https://github.com/bbi-lab/igvf-scalable-vus-resolution"
license: BSD-3-Clause
